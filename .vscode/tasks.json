{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "restart temporal",
            "type": "shell",
            "command": "cd Temporal-Light && git pull && docker compose down && docker compose build --pull && docker compose up -d",
        },
        {
            "label": "clear temporal db",
            "type": "shell",
            "command": "docker exec temporal-light-postgres-1 psql -U tl -d temporal_light -c \"TRUNCATE events, workflows, workers RESTART IDENTITY CASCADE;\"",
        }
    ]
}